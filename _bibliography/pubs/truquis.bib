@article{Signor2024-or,
  abstract   = {
                Context. The chemical composition of a star's atmosphere reflects the chemical composition of
                its birth environment. Therefore, it should be feasible to recognize stars born together that
                have scattered throughout the galaxy, solely based on their chemistry. This concept, known as
                ``strong chemical tagging'', is a major objective of spectroscopic studies, but it has yet to
                yield the anticipated results. Aims. We assess the existence and the robustness of the relation
                between chemical abundances and the birthplace using known member stars of open clusters.
                Methods. We followed a supervised machine learning approach, using chemical abundances obtained
                from APOGEE DR17, observed open clusters as labels, and different data preprocessing
                techniques. Results. We find that open clusters can be recovered with any classifier and on
                data whose features are not carefully selected. In the sample with no field stars, we obtain an
                average accuracy of 75.2\% and we find that the prediction accuracy mostly depends on the
                uncertainties of the chemical abundances. When field stars outnumber the cluster members, the
                performance degrades. Conclusions. Our results show the difficulty of recovering birth clusters
                using chemistry alone, even in a supervised scenario. This clearly challenges the feasibility
                of strong chemical tagging. Nevertheless, including information about ages could potentially
                enhance the possibility of recovering birth clusters.
                },
  author     = {Signor, Theosamuele and Jofr\'{e}, Paula and Mart\'{i}, Luis and Sanchez-Pi, Nayat},
  doi        = {10.1051/0004-6361/202449938},
  issn       = {0004-6361,1432-0746},
  journal    = {Astronomy and Astrophysics},
  month      = {8},
  number     = {A165},
  pages      = {15},
  publisher  = {EDP Sciences},
  title      = {A baseline on the relation between chemical patterns and the birth stellar cluster},
  url        = {https://www.aanda.org/articles/aa/abs/2024/08/aa49938-24/aa49938-24.html},
  volume     = {688},
  year       = {2024},
}

@inproceedings{callejas-2024:carla,
  abstract  = {
               Plankton plays a crucial role in the marine ecosystem, contributing to the biogeochemical cycle
               and climate regulation. Traditional plankton monitoring methods struggle with the complex
               dynamics of ocean ecosystems, leading to a growing interest in computer vision techniques for
               plankton identification in microscopic images. However, most studies have used small,
               controlled datasets. Our research is the first to employ large, unbalanced datasets to achieve
               state-of-the-art plankton image recognition, bridging the gap between laboratory and real-world
               conditions. We addressed the challenge of training large models in a heterogeneous GPU
               environment, utilizing advanced models like Swin Transformers and DeiT 3, along with data
               augmentation and varied loss functions. Our results demonstrate that Vision Transformers (ViTs)
               excel in plankton image recognition, offering significant potential to improve climate change
               mitigation strategies.
               },
  author    = {Callejas, Sof\'{i}a and Lira, Hernan and Berry, Andrew and Mart\'{i}, Luis and Sanchez-Pi, Nayat},
  booktitle = {High Performance Computing: 11th Latin American High Performance Computing Conference ({CARLA} 2024)},
  editor    = {Gin\'{e}s Guerrero and San Mart\'{i}n and Esteban Meneses and Barrios H, Carlos J and Osthoff, Carla and Monsalve Diaz, Jose M},
  isbn      = {978-3-031-80083-2},
  issn      = {1865-0929},
  month     = oct,
  series    = {Communications in Computer and Information Science},
  title     = {No Plankton Left Behind: {P}reliminary results on massive plankton image recognition},
  year      = {2024},
}

@inproceedings{10.1007/978-3-031-80366-6_7,
  abstract   = {
                Plankton is a vital component of marine ecosystems, integral to the biogeochemical cycles and
                climate regulation processes. Their abundance fluctuations serve as key indicators of ocean
                health. Accurate identification of plankton is therefore essential. Traditional monitoring
                methods, however, struggle with the complex spatial and temporal dynamics of ocean
                environments. In response, modern computer vision techniques have increasingly been applied to
                enhance plankton identification in microscopic images. While existing studies have
                predominantly used small, controlled laboratory datasets, our research addresses this gap by
                employing large, unbalanced datasets, thereby aligning more closely with real-world conditions.
                We utilize advanced models, including Swin Transformers and DeiT 3, incorporating data
                augmentation and diverse loss functions to boost classification accuracy. Additionally, we
                perform a systematic comparison of six GradCAM algorithms to gain explainability insights into
                the recognition process. Our results indicate that Vision Transformers (ViTs) outperform
                traditional methods, showcasing their potential to revolutionize plankton image recognition.
                },
  address    = {Cham},
  author     = {Callejas, Sof\'{i}a and Lira, Hernan and Berry, Andrew and Mart\'{i}, Luis and Sanchez-Pi, Nayat},
  booktitle  = {Advances in Artificial Intelligence --- IBERAMIA 2024},
  doi        = {10.1007/978-3-031-80366-6_7},
  editor     = {Correia, Lu{\'\i}s and Ros{\'a}, Aiala and Garijo, Francisco},
  isbn       = {978-3-031-80366-6},
  location   = {Montevideo, Uruguay},
  month      = nov,
  pages      = {74--86},
  publisher  = {Springer Nature Switzerland},
  series     = {Lecture Notes in Computer Science},
  title      = {Capturing the Essence of Plankton:{A} Gradient-Weighted Class Activation Mapping Analysis},
  year       = {2024},
}

@inproceedings{10.1007/978-3-031-80366-6_15,
  abstract   = {
                Deforestation poses a significant threat to global ecological stability, particularly in the
                Latin American and Caribbean (LAC) region. This study aims to develop an advanced instance
                segmentation model using deep learning to monitor deforestation with satellite imagery. The
                model integrates spatial and temporal analysis to accurately identify deforested areas,
                addressing challenges such as data quality, class imbalance, and varying image exposures with
                advanced preprocessing, a robust training pipeline, and U-Net and Feature Pyramid Network
                architecture. A visualization dashboard tracks deforestation over time, enabling model
                performance evaluation across multiple LAC regions. Validated against known deforestation
                events, the model effectively detects and monitors forest loss, providing a valuable tool for
                policymakers and environmental managers.
                },
  address    = {Berlin, Heidelberg},
  author     = {Lira, Hernan and de Wolff, Taco and Mart\'{i}, Luis and Sanchez-Pi, Nayat},
  booktitle  = {Advances in Artificial Intelligence --- {IBERAMIA} 2024: 18th Ibero-American Conference on AI},
  doi        = {10.1007/978-3-031-80366-6_15},
  isbn       = {978-3-031-80365-9},
  keywords   = {Deforestation Monitoring, Image Segmentation, Satellite Imagery},
  location   = {Montevideo, Uruguay},
  numpages   = {12},
  pages      = {173--184},
  publisher  = {Springer-Verlag},
  title      = {{FairTrees}: {A} Deep Learning Approach for Identifying Deforestation on Satellite Images},
  url        = {https://doi.org/10.1007/978-3-031-80366-6_15},
  year       = {2025},
}

@inproceedings{10.1145/3712255.3734346,
  abstract  = {We introduce Hierarchical Multi-view Symbolic Regression (H-MvSR), a novel evolutionary framework that discovers closed-form expressions linking environmental drivers to functional gene abundances across multiple ocean layers. Our method models each depth layer as a separate view while enforcing hierarchical constraints that promote both global structural consistency and local biological specificity. The symbolic models are evolved under multi-objective criteria that balance predictive accuracy, expression simplicity, and cross-view coherence. Furthermore, the framework incorporates pathway-level biological priors, enabling grouped symbolic modeling of molecular functions participating in the same metabolic process. We evaluate H-MvSR using depth-resolved genomic and environmental data from global ocean expeditions and compare its performance against state-of-the-art SR systems. Results show that H-MvSR improves interpretability and multiview consistency while recovering biologically meaningful relationships.},
  address   = {New York, NY, USA},
  author    = {Lira, Hernan and Mart\'{i}, Luis and Sanchez-Pi, Nayat},
  booktitle = {Proceedings of the Genetic and Evolutionary Computation Conference Companion},
  doi       = {10.1145/3712255.3734346},
  isbn      = {9798400714641},
  keywords  = {symbolic regression, genetic programming, metabolic functions, metabolic pathways},
  location  = {NH Malaga Hotel, Malaga, Spain},
  numpages  = {9},
  pages     = {2539--2547},
  publisher = {Association for Computing Machinery},
  series    = {GECCO'25 Companion},
  title     = {A Hierarchical Multiview Symbolic Regression Method for Decoding Oceanic Metabolism},
  url       = {https://doi.org/10.1145/3712255.3734346},
  year      = {2025},
}

@article{signor2026-mg,
  abstract      = {Chemical abundance determinations from stellar spectra are challenged by observational noise, limitations in stellar models, and departures from simplifying assumptions. While traditional and supervised machine learning methods have made remarkable progress in estimating atmospheric parameters and chemical compositions within existing physical models, these factors still constrain our ability to fully exploit the vast datasets provided by modern spectroscopic surveys. We aim to develop a self-supervised, disentangled representation learning framework that extracts chemically meaningful features directly from spectra, without relying on externally imposed label catalogs. We built a variational autoencoder-based representation learning model with a physics-inspired structure comprising multiple decoders, each of which focuses on spectral regions dominated by a particular element, enforcing that each latent dimension maps to a single abundance. To evaluate the potential application of our framework, we trained and validated the model on low-resolution, low signal-to-noise synthetic spectra. We then demonstrate how the trained model can be used to flag stars as chemically enhanced or depleted in these abundances based on their position within the latent distribution. Our model successfully learns a representation of spectra whose axes correlate tightly with the target abundances. The disentangled representations provide a robust means to distinguish stars based on their chemical properties, offering an efficient and scalable solution for large spectroscopic surveys.},
  archiveprefix = {arXiv},
  author        = {Signor, Theosamuele and Jofr\'{e}, Paula and Lira, Hernan and Vitali, Sara and Mart\'{i}, Luis and Sanchez-Pi, Nayat},
  doi           = {10.1051/0004-6361/202555376},
  eprint        = {2511.09733},
  issn          = {0004-6361,1432-0746},
  journal       = {Astronomy and astrophysics},
  language      = {en},
  number        = {A279},
  pages         = {16},
  primaryclass  = {astro-ph.SR},
  publisher     = {EDP Sciences},
  title         = {{T}oward model-free stellar chemical abundances. {P}otential applications in the search for chemically peculiar stars in large spectroscopic surveys},
  volume        = {704},
  year          = {2025},
}



@inproceedings{valenzuela-2025:icprs,
  abstract  = {A significant portion of genes within marine metagenomes remain functionally uncharacterized, and these could be crucial for realistic quantification of the Biological Carbon Pump. Recent advances in self-supervised language models offer promising alternatives to traditional annotation pipelines. In this study, we systematically evaluate the effectiveness of embeddings generated by leading genome-level (GenomeOcean, gLM2) and protein-level (ESM2, ESMC, ESM3) language models on downstream prediction tasks. Using a curated dataset of Biological Carbon Pump-associated genes from the Tara Oceans project, we train transformer-based classifiers to perform functional annotation (KEGG Orthology) and taxonomic classification. To mitigate severe class imbalance, we implemented three loss functions derived from Cross-Entropy, with Weighted Cross-Entropy (WCE) consistently yielding the best predictive performance. Our results show that genome-level models, particularly GenomeOcean, substantially outperform protein-level counterparts across both tasks. Moreover, concatenating gene-and protein-based embeddings into a multi-modal representation further improves predictive accuracy, outperforming all single-modality configurations. These findings underscore both the value of pretraining directly on large metagenomic contigs and the advantage of integrating complementary molecular modalities for enhancing predictive performance in specialized ecological contexts.},
  author    = {Luis Valenzuela and Camila Reyes and Luis Mart\'{i} and Nayat Sanchez-Pi},
  booktitle = {IEEE 15th International Conference on Pattern Recognition Systems (ICPRS)},
  doi       = {10.1109/ICPRS66293.2025.11302855},
  editor    = {Cesar Astudillo and Karol Suchan and Sergio A. Velastin},
  keywords  = {Proteins;Analytical models;Translation;Accuracy;Annotations;Biological system modeling;Transformers;Bioinformatics;Biological information theory;Carbon;Large Language Models;genomics;proteins;Biological Carbon Pump;embeddings},
  location  = {Vi\~{n}a del Mar, Chile},
  pages     = {1--7},
  title     = {A Comparative Analysis of Language Model Embeddings from Genes and Proteins involved in the Biological Carbon Pump},
  year      = {2025},
}

@inproceedings{lira-2025:icprs,
  abstract  = {This work addresses Neural Machine Translation (NMT) for Spanish–Mapudungun, an endangered and digitally under-resourced indigenous language of South America with polysynthetic and agglutinative morphology. We explore transfer learning as a strategy to mitigate data scarcity, initializing Spanish–Mapudungun models from high-resource pairs (Spanish–English and Spanish–Finnish). Using a standardized 10,000-pair corpus, we show that transfer learning markedly improves translation quality in both directions over models trained from scratch. We further analyze whether the linguistic characteristics of the parent language—particularly morphological similarity—affect transfer effectiveness. Results indicate that both parent models achieve similar gains, suggesting that vocabulary coverage and tokenization dominate over morphological resemblance. These findings demonstrate the utility of transfer learning for endangered languages and underscore the need for linguistically informed methods and community involvement in revitalization efforts.},
  author    = {Hernan Lira and Luis Mart\'{i} and Nayat Sanchez-Pi},
  booktitle = {IEEE 15th International Conference on Pattern Recognition Systems (ICPRS)},
  doi       = {10.1109/ICPRS66293.2025.11302844},
  editor    = {Cesar Astudillo and Karol Suchan and Sergio A. Velastin},
  keywords  = {Training;South America;Vocabulary;Schedules;Translation;Transfer learning;Neural machine translation;Linguistics;Data models;Tokenization;neural machine translation;transfer learning;low-resource languages},
  location  = {Vi\~{n}a del Mar, Chile},
  pages     = {1--7},
  title     = {Spanish-{M}apudungun Translation using Transfer Learning for Low-resource languages},
  year      = {2025},
}

@inproceedings{chacra-2025:icprs,
  abstract  = {We investigate the application of Physics-Informed Neural Networks (PINNs) to a coupled bio-physical modeling problem involving turbulent fluid dynamics and nutrient transport-processes that are central to oceanographic and environmental systems. Our approach leverages recent advances in deep learning to solve partial differential equations (PDEs) by embedding physical constraints directly into the network architecture. Specifically, we model two-dimensional decaying turbulence using the incompressible Navier--Stokes equations and couple it with a passive scalar advection equation for nutrient transport. We evaluate three PINN variants: vanilla PINN, causal PINN (cPINN), and Causal R3 PINN, comparing their performance using a high-resolution numerical solver as reference. Results show that cPINN achieves the lowest mean spatial L2 error (approximately 50\% lower than vanilla PINN), while Causal R3 PINN fails to converge effectively. Computational throughput analysis reveals vanilla PINN processes 24.05 iterations per second compared to cPINN’s 12.57, representing a 2x speed difference. This work contributes to the growing field of scientific machine learning by providing quantitative benchmarks and revealing method-specific limitations in realistic, coupled environmental scenarios.},
  author    = {Emir Chacra and Paul Escapil-Inchausp\'{e} and Luis Mart\'{i} and Nayat Sanchez-Pi},
  booktitle = {IEEE 15th International Conference on Pattern Recognition Systems (ICPRS)},
  doi       = {10.1109/ICPRS66293.2025.11302850},
