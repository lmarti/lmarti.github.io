@inproceedings{agn-bilbao,
  abstract  = {The classic classification scheme for Active Galactic Nuclei (AGNs) was recently
               challenged by the discovery of the so-called changing-state (changing-look) AGNs
               (CSAGNs). The physical mechanism behind this phenomenon is still a matter
               of open debate and the samples are too small and of serendipitous nature to
               provide robust answers. To tackle this problem, we need to design methods that
               can detect AGN right in the act of changing-state.
               Previous approaches at detecting CSAGN in massive archival datasets have
               employed simple statistical analysis to find them, using for instance measurements of the variability amplitude, or more complex analysis like
               Bayesian blocks representation. However, these methods are not suitable
               for the real-time detection of CSAGN events, since they favor the detection of
               events well after they have occurred, and not the detection of the transition
               phase. More promising techniques involve time series forecasting or the use of
               anomaly detection algorithms.
               In this work we present a novel anomaly detection technique designed
               to identify AGN light curves with anomalous behaviors in massive datasets, in
               preparation for the upcoming Vera Rubin Observatory. The main aim of this
               technique is to identify CSAGN at different stages of the transition, but it can
               also be used for more general purposes, such as cleaning massive datasets for
               AGN variability analyses.},
  address   = {Bilbao, Spain},
  author    = {P. S{\'a}nchez-S{\'a}ez and Hernan Lira and Mart\'{i}, Luis and Nayat Sanchez-Pi},
  booktitle = {Space and AI 2021 workshop at European Conference on Machine Learning and Principles and Practice of Knowledge Discovery in Databases (ECML PDKK 2021)},
  month     = {9},
  title     = {Anomaly detection for real-time identification of changing-state AGNs in massive datasets},
  year      = {2021},
}

@report{dewolff:hal-03260357,
  abstract      = {The carbon pump of the world's ocean plays a vital role in the biosphere and climate of the earth, urging improved understanding of the functions and influences of the ocean for climate change analyses. State-of-the-art techniques are required to develop models that can capture the complexity of ocean currents and temperature flows. This work explores the benefits of using physics-informed neural networks (PINNs) for solving partial differential equations related to ocean modeling; such as the Burgers, wave, and advection-diffusion equations. We explore the trade-offs of using data vs. physical models in PINNs for solving partial differential equations. PINNs account for the deviation from physical laws in order to improve learning and generalization. We observed how the relative weight between the data and physical model in the loss function influence training results, where small data sets benefit more from the added physics information.},
  archiveprefix = {arXiv},
  author        = {de Wolff, Taco and Carrillo, Hugo and Mart\'{i}, Luis and Sanchez-Pi, Nayat},
  eprint        = {2106.08747},
  hal_id        = {hal-03260357},
  hal_version   = {v1},
  month         = {5},
  note          = {Under review},
  pdf           = {https://hal.inria.fr/hal-03260357/file/neurips_neural-based_solver.pdf},
  primaryclass  = {physics.ao-ph},
  title         = {Towards Optimally Weighted Physics-Informed Neural Networks in Ocean Modelling},
  url           = {https://hal.inria.fr/hal-03260357},
  year          = {2021},
}

