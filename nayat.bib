  publisher  = {Springer},
  series     = {Lecture Notes in Computer Science},
  timestamp  = {Mon, 15 Jun 2020 17:04:18 +0200},
  title      = {Increasing Availability Control of Human Biological Samples Using a Mobile Management System},
  url        = {https://doi.org/10.1007/978-3-030-22219-2\%5F5},
  volume     = {11582},
  year       = {2019},
  bdsk-url-1 = {https://doi.org/10.1007/978-3-030-22219-2%5C%5F5},
  bdsk-url-2 = {https://doi.org/10.1007/978-3-030-22219-2_5}
