@inproceedings{vieira-2018:iscif,
  abstract   = {
                The Ambient Intelligence Development Environment (AIDE) tool allows developers of Ambient
                Assisted Living (AAL) solutions to test their projects in a virtual environment. The simulation
                reduces the onus on systems development in AAL, proving to be an adequate tool for the adoption
                of agile methodologies in AAL projects. This work presents the implementation of an extension
                of AIDE that enables designers to test their solutions with the end user through the virtual
                reality environment. AIDE-VR extends the simulations of the first tool to be used with the end
                users of the product in an immersive experience through the use of virtual reality.
                },
  author     = {Vieira de Aguiar, Thiago and Sanchez-Pi, Nayat and Benjamim Werneck, Vera Maria},
